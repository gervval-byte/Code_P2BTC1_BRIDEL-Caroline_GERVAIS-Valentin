'''Definition of functions'''
def find_number_of_mice(folderpath):
    # Initialize the max_ID
    max_id = 0
    f=open(folderpath,'r')
    # Remove the first line
    f.readline() 
    # Getting the values from the first row of data
    line=f.readline()
    # For each line
    while line !="":
        # Remove invisible characters at the end
        line = line.strip()
        # Split the line into a list using ';' as separator
        column = line.split(';')
        # Get the mouse_id
        mouse_id = column[4] 
        if mouse_id.startswith("ABX"):
            # Remove "ABX" 
            number = int(mouse_id[3:])
            #If number is bigger than the max_id then max_id is replaced by number 
            if number > max_id:
                max_id = number
        line = f.readline()
    f.close()
    return max_id

# Function to retrieve the x and y values and
# associates a string with treatment
def data_extraction(data):
    vx=int(data[7])
    vy=math.log10(float(data[8]))
    treatment=data[5]
    return vx, vy, treatment

# Function for the list of data for the output file
def save_data(file_object, mouse_id, treatment, area, x, y):
    # Creating the list of values (converting x and y to str)
    list_to_write = [mouse_id, treatment, area, str(x), str(y)]
    # Junction with semicolons
    list_data = ";".join(list_to_write)
    # Writing to the file with a line break
    file_object.write(list_data + "\n")

# Function to plot a data curve of the log10 of the number of bacteria 
# as a function of the day of treatment
def plot_fecal_data(x, y, treatment, axes_fecal, used_label_fecal):
    clr = '#0000FF'
    if treatment == 'ABX':
        clr = '#FF0000'
    
    # Allows adding a single legend per process
    if treatment not in used_label_fecal: 
        axes_fecal.plot(x, y, label=treatment, color=clr, alpha=0.5)
        used_label_fecal.add(treatment) 
    else:
        axes_fecal.plot(x, y, color=clr, alpha=0.5)
        
    axes_fecal.grid(True)
    axes_fecal.set_title("Fecal live bacteria")
    axes_fecal.set_xlabel("Treatment's day")
    axes_fecal.set_ylabel("log(10)(live bacteria/wetg)")
    figure_fecal.legend(loc="upper right") # Caption with its location
    images_pathway_data_fecal=os.path.join(images_pathway,"outfecal.png")
    figure_fecal.savefig(images_pathway_data_fecal) # Name of the file and it's output



# Function to draw a violin plot of the log10 of the number of bacteria 
# as a function of treatment
def create_violin_plot(abx, placebo,points, axes, title,bottom):
    colors = ['#FF6633', '#3366FF'] # ABX (red/orange), Placebo (blue)
    all_data = abx + placebo
    y_min = min(all_data) - 0.05
    y_max = max(all_data) + 0.05
    # Creation of the violin plot
    parts = axes.violinplot([abx, placebo], showmeans=False, showmedians=True) 

    for i, pc in enumerate(parts['bodies']):
        pc.set_facecolor(colors[i])
        pc.set_edgecolor('black')
        pc.set_alpha(0.5)

    # Random placement of points on X
    position_x = []
    position_y = []
    colorviolin = []

    for point in points:
        position_x.append(point[0])
        position_y.append(point[1])
        colorviolin.append(point[2])

    random_position = []
    for point in position_x:
        gap = random.uniform(-0.1, 0.1)
        random_position.append(point + gap)

    axes.scatter(random_position, position_y, color=colorviolin, s=10, alpha=0.6, linewidths=0.5)

    # Axis configuration
    axes.grid(True)
    axes.set_ylim(bottom=y_min,top=y_max)
    axes.set_xticks([1, 2])
    axes.set_xticklabels(['ABX', 'Placebo'])
    axes.set_ylabel('log(10)(live bacteria/wetg)')
    axes.set_title(title)


